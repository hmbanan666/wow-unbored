{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbored.kosarev.space/schema/plan.json",
  "title": "Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "kind", "tasks"],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "plan"
    },
    "mode": {
      "type": "string"
    },
    "budget": {
      "type": "integer",
      "description": "Optional. Information only; a Plan covers the whole goal (ADR 0037)."
    },
    "note": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "description": "A short human name like a quest title; no tokens. Server warns and cuts (ADR 0038)."
    },
    "goal": {
      "type": "string",
      "description": "One sentence, at most 160 bytes. May carry entity markup."
    },
    "details": {
      "type": "string",
      "description": "Facts and state, at most 600 bytes. May carry entity markup."
    },
    "rewards": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^\\{[a-z]+:[^{}]+\\}$",
        "description": "One link token of kind mount, ach, item, toy, currency or pet."
      }
    },
    "generatedAt": {
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "May carry entity markup (markup.md)."
          },
          "estMinutes": {
            "type": "integer"
          },
          "mapID": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "description": "May carry entity markup (markup.md)."
          },
          "why": {
            "type": "string",
            "description": "One short reason, at most 120 bytes. May carry entity markup."
          },
          "rewards": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^\\{[a-z]+:[^{}]+\\}$"
            }
          },
          "condition": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "description": "Shown before the step; check runs live in the game (D95).",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "At most 160 bytes. May carry entity markup."
              },
              "check": {
                "type": "object",
                "required": ["kind", "id"],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": ["currency", "item", "level", "quest", "ach"]
                  },
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "For level, the level."
                  },
                  "atLeast": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "description": "Side table for {npc:ID} tokens in titles, notes and messages (markup.md). x and y are map percent 0-100.",
      "additionalProperties": false,
      "properties": {
        "npc": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "pattern": "^[1-9][0-9]{0,9}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mapID": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
