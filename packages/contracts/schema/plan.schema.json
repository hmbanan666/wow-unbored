{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbored.kosarev.space/schema/plan.json",
  "title": "Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "kind", "tasks"],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "plan"
    },
    "mode": {
      "type": "string"
    },
    "budget": {
      "type": "integer",
      "description": "Optional. Information only; a Plan covers the whole goal (ADR 0037)."
    },
    "note": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "description": "A short human name like a quest title; no tokens. Server warns and cuts (ADR 0038)."
    },
    "goal": {
      "type": "string",
      "description": "One sentence, at most 160 bytes. May carry entity markup."
    },
    "details": {
      "type": "string",
      "description": "Optional context, at most 200 UTF-8 bytes; Server shortens at a word and warns."
    },
    "rewards": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^\\{[a-z]+:[^{}]+\\}$",
        "description": "One link token of kind mount, ach, item, toy, currency or pet."
      }
    },
    "contains": {
      "type": "object",
      "maxProperties": 2,
      "description": "Reward contents (ADR 0055): a container reward {item:ID} (in rewards or a step's rewards) to what it may hold. The container is the reward; never list its contents as rewards.",
      "propertyNames": {
        "pattern": "^\\{item:[0-9]+(\\|[^{}]*)?\\}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "string",
          "pattern": "^\\{(mount|toy|pet|item):[^{}]+\\}$"
        }
      }
    },
    "generatedAt": {
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "At most 70 characters and 240 UTF-8 bytes. Server shortens at a word and warns.",
            "maxLength": 70
          },
          "estMinutes": {
            "type": "integer"
          },
          "mapID": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "description": "Optional, at most 400 UTF-8 bytes. Server shortens at a word and warns.",
            "maxLength": 400
          },
          "why": {
            "type": "string",
            "description": "Optional, at most 80 UTF-8 bytes. Server shortens at a word and warns.",
            "maxLength": 80
          },
          "rewards": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^\\{[a-z]+:[^{}]+\\}$"
            }
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,24}$",
            "description": "Step group (ADR 0056): consecutive steps (at least 2) with the same group are done in any order."
          },
          "condition": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "description": "Shown before the step; check runs live in the game (D95).",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "At most 160 bytes. May carry entity markup."
              },
              "check": {
                "type": "object",
                "required": ["kind", "id"],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": ["currency", "item", "level", "quest", "ach"]
                  },
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "For level, the level."
                  },
                  "atLeast": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      },
      "maxItems": 40
    },
    "entities": {
      "type": "object",
      "description": "Side table for {npc:ID} tokens in titles, notes and messages (markup.md). x and y are map percent 0-100.",
      "additionalProperties": false,
      "properties": {
        "npc": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "pattern": "^[1-9][0-9]{0,9}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mapID": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "outcome": {
      "description": "One near-guaranteed target; required on planner submission, optional only for legacy delivery. ADR 0068.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "factionID", "standing"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rep"
            },
            "factionID": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "standing": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "factionID", "level"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "renown"
            },
            "factionID": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "level"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "level"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "achievementID"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "achievement"
            },
            "achievementID": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mount"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pet"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "toy"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "item"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "currencyID", "amount"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "currency"
            },
            "currencyID": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      ]
    },
    "bonus": {
      "description": "Up to three chance reward tokens, never the goal; describe as possible bonuses in a Step note for 0.11.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}
