{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbored.kosarev.space/schema/profile.json",
  "title": "Player profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["character", "profile"],
  "properties": {
    "character": { "type": "string", "minLength": 1 },
    "realm": { "type": "string" },
    "account": { "type": "string" },
    "accountLegacy": {
      "type": "string",
      "description": "Unhashed Account key, sent once so existing rows can be renamed (docs/adr/0044)."
    },
    "savedAt": { "type": ["integer", "null"] },
    "profile": { "type": "object" }
  }
}
