{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbored.kosarev.space/schema/suggestions.json",
  "title": "Suggestions",
  "description": "GET /v1/suggestions, and UnboredSuggestions in Unbored_Plan/Suggestions.lua (D106). Made by the Server from the player's own data and the catalog only.",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "computedAt", "characters"],
  "properties": {
    "v": {
      "const": 1
    },
    "computedAt": {
      "type": "integer"
    },
    "characters": {
      "type": "object",
      "description": "Keyed by Realm-Name for Retail and forever/Realm-Name for Forever.",
      "additionalProperties": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "$ref": "#/$defs/suggestion"
        }
      }
    }
  },
  "$defs": {
    "suggestion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "title", "goal", "rewards", "request"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": ["event", "achievement", "rare", "collection", "chain", "path", "profession"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "titleToken": {
          "type": "string",
          "description": "The addon shows the game's own name of this token as the title."
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "At most 140 bytes; tokens allowed."
        },
        "why": {
          "type": "string",
          "description": "At most 100 bytes, English; the addon prefers reason."
        },
        "reason": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["ends", "alts", "near", "starts", "stopped", "altDone"]
            },
            "at": {
              "type": "integer"
            },
            "count": {
              "type": "integer",
              "minimum": 2
            },
            "mapID": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "maxLength": 60,
              "description": "altDone: the Character that finished the chain."
            }
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "mapID": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "integer"
        },
        "chain": {
          "type": "object",
          "description": "Set with kind chain (D135): ids from the client only.",
          "required": ["questLineID", "done", "total"],
          "properties": {
            "questLineID": {
              "type": "integer",
              "minimum": 1
            },
            "nextQuestID": {
              "type": "integer",
              "minimum": 1
            },
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "request": {
          "type": "object",
          "required": ["topic", "suggestionId", "wish"],
          "properties": {
            "topic": {
              "const": "suggestion"
            },
            "suggestionId": {
              "type": "string",
              "minLength": 1
            },
            "wish": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "displayKind": {
          "enum": [
            "event",
            "achievement",
            "rare",
            "collection",
            "chain",
            "mount",
            "path",
            "profession"
          ],
          "description": "Display label only; kind still controls ranking and Taste."
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^{}|\\r\\n]+$",
          "description": "Plain text in the Character language, at most 60 UTF-8 bytes (enforced by consumers)."
        },
        "progress": {
          "type": "object",
          "required": ["done", "total"],
          "description": "Known criteria, quests or collected rewards. done <= total; absent when unknown.",
          "properties": {
            "done": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "slug", "locale", "version"],
          "properties": {
            "kind": {
              "enum": ["path", "collection"]
            },
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "locale": {
              "enum": ["en", "ru"]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "profession": {
          "type": "object",
          "required": ["game", "skillLine", "from", "target", "nextCrafts"],
          "properties": {
            "game": {
              "enum": ["retail", "forever"]
            },
            "skillLine": {
              "type": "integer",
              "minimum": 1
            },
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "nextCrafts": {
              "type": "integer",
              "minimum": 0
            },
            "rankMax": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            }
          },
          "if": {
            "required": ["rankMax"]
          },
          "then": {
            "properties": {
              "nextCrafts": {
                "const": 0
              },
              "game": {
                "const": "forever"
              }
            }
          },
          "else": {
            "properties": {
              "nextCrafts": {
                "minimum": 1
              }
            }
          }
        },
        "plan": {
          "type": "object",
          "required": ["v", "kind", "tasks"],
          "properties": {
            "v": {
              "const": 1
            },
            "kind": {
              "const": "plan"
            },
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["path"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "profession"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["profession", "plan"]
          }
        }
      ]
    }
  }
}
