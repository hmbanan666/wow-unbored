{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbored.kosarev.space/schema/request.json",
  "title": "Request",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "character", "realm", "type"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "integer" },
    "character": { "type": "string", "minLength": 1 },
    "realm": { "type": "string" },
    "type": { "enum": ["plan", "item", "question"] },
    "mode": { "type": "string" },
    "budget": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240,
      "description": "Only when the player typed minutes in the custom form (ADR 0037)."
    },
    "wish": { "type": "string" },
    "question": { "type": "string" },
    "topic": { "type": "string" },
    "lang": { "type": "string" },
    "account": { "type": "string" },
    "item": {
      "type": "object",
      "required": ["itemID"],
      "properties": {
        "itemID": { "type": "integer", "minimum": 1 },
        "link": { "type": "string" },
        "name": { "type": "string" },
        "bag": { "type": "integer" },
        "slot": { "type": "integer" },
        "count": { "type": "integer" }
      }
    },
    "context": { "type": "object" },
    "suggestionId": {
      "type": "string",
      "minLength": 1,
      "description": "With topic \"suggestion\": the picked Suggestion (D109)."
    },
    "suggestion": {
      "type": "object",
      "description": "A copy of the picked Suggestion; its tokens are ground truth for ids.",
      "required": ["id", "kind", "title", "goal", "rewards"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "why": { "type": "string" },
        "rewards": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "mapID": { "type": "integer" },
        "expiresAt": { "type": "integer" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "plan" } },
        "required": ["type"]
      },
      "then": { "required": ["mode"] }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["item", "question"] } },
        "required": ["type"]
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["mode"] }, { "required": ["budget"] }]
        }
      }
    }
  ]
}
